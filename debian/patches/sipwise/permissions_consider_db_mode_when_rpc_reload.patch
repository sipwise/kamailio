From: Sipwise Development Team <support@sipwise.com>
Date: Tue, 4 Aug 2026 11:24:57 +0200
Subject: permissions_consider_db_mode_when_rpc_reload

---
 src/modules/permissions/rpc.c | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/modules/permissions/rpc.c b/src/modules/permissions/rpc.c
index d4e8e0d..430022a 100644
--- a/src/modules/permissions/rpc.c
+++ b/src/modules/permissions/rpc.c
@@ -58,12 +58,19 @@ void rpc_trusted_reload(rpc_t *rpc, void *c)
 		return;
 	}
 
-	if(reload_trusted_table_cmd() != 1) {
-		rpc->fault(c, 500, "Reload failed.");
-		goto done;
+	// only reload the hash buckets then, when the cache is activated (db_mode = 1)
+	if(perm_db_mode == ENABLE_CACHE) {
+		if(reload_trusted_table_cmd() != 1) {
+			rpc->fault(c, 500, "Reload failed.");
+			goto done;
+		}
+		rpc->rpl_printf(c, "Reload OK");
+	} else {
+		LM_DBG("Skip trusted sources reload in hash buckets, caching is "
+			   "disabled.\n");
+		rpc->fault(c, 200, "Reload skipped (disabled cache)");
 	}
 
-	rpc->rpl_printf(c, "Reload OK");
 done:
 	// reloading is done
 	*perm_rpc_reload_time = time(NULL);
