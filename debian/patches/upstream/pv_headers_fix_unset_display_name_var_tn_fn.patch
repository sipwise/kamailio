From ba2de7895c2ce96a66e3dea96047dd783f113601 Mon Sep 17 00:00:00 2001
From: Victor Seva <vseva@sipwork.pro>
Date: Thu, 22 Oct 2026 00:14:17 +0200
Subject: [PATCH] pv_headers: fix unset display name var $x_tn $x_fn

* fail early on unsupported unset operations

fixes #5033
---
 src/modules/pv_headers/pvh_str.c  |  4 +-
 src/modules/pv_headers/pvh_xavp.c | 61 +++++++++++++++++++------------
 2 files changed, 41 insertions(+), 24 deletions(-)

diff --git a/src/modules/pv_headers/pvh_str.c b/src/modules/pv_headers/pvh_str.c
index 112bbf3d5e..e486a512ca 100644
--- a/src/modules/pv_headers/pvh_str.c
+++ b/src/modules/pv_headers/pvh_str.c
@@ -68,8 +68,10 @@ int pvh_str_append(str *dst, str *src, unsigned int max_size)
 {
 	int src_len = 0;
 
-	if(src == NULL || dst == NULL || src->len <= 0)
+	if(src == NULL || dst == NULL || src->len < 0)
 		return -1;
+	if(src->len == 0)
+		return 1;
 
 	if(dst->len + src->len + 1 >= max_size) {
 		src_len = max_size - dst->len - 1;
diff --git a/src/modules/pv_headers/pvh_xavp.c b/src/modules/pv_headers/pvh_xavp.c
index cfa2e963ac..a426394280 100644
--- a/src/modules/pv_headers/pvh_xavp.c
+++ b/src/modules/pv_headers/pvh_xavp.c
@@ -816,26 +816,33 @@ int pvh_set_uri(struct sip_msg *msg, pv_param_t *param, int op, pv_value_t *val)
 	enum action_type a_type;
 	char t[pvh_hdr_name_size];
 	str hname = {t, pvh_hdr_name_size - 1};
-	str fval;
+	str fval = STR_NULL;
 
 	p_no = param->pvn.u.isname.name.n;
-	if(p_no >= 1 && p_no <= 5)
-		pvh_str_copy(&hname, &pvh_hdr_from, pvh_hdr_name_size);
-	else if(p_no >= 6 && p_no <= 10)
-		pvh_str_copy(&hname, &pvh_hdr_to, pvh_hdr_name_size);
-
 	switch(p_no) {
 		case 1: // uri from
 		case 6: // uri to
 			a_type = SET_URI_T;
+			if(!val) {
+				LM_ERR("uri can't be unset\n");
+				goto err;
+			}
 			break;
 		case 2: // username from
 		case 7: // username to
 			a_type = SET_USER_T;
+			if(!val) {
+				LM_ERR("user can't be unset\n");
+				goto err;
+			}
 			break;
 		case 3: // domain from
 		case 8: // domain to
 			a_type = SET_HOST_T;
+			if(!val) {
+				LM_ERR("host can't be unset\n");
+				goto err;
+			}
 			break;
 		case 4: // displayname from
 		case 9: // displayname to
@@ -846,19 +853,25 @@ int pvh_set_uri(struct sip_msg *msg, pv_param_t *param, int op, pv_value_t *val)
 			goto err;
 	}
 
-	if(val->flags & (PV_TYPE_INT | PV_VAL_INT)) {
-		if(pv_get_sintval(msg, param, val, val->ri) < 0)
-			goto err;
-	}
+	if(p_no >= 1 && p_no <= 5)
+		pvh_str_copy(&hname, &pvh_hdr_from, pvh_hdr_name_size);
+	else if(p_no >= 6 && p_no <= 10)
+		pvh_str_copy(&hname, &pvh_hdr_to, pvh_hdr_name_size);
 
-	if(pv_parse_format(&val->rs, &pv_format) < 0) {
-		LM_ERR("cannot parse format: %.*s\n", val->rs.len, val->rs.s);
-		goto err;
-	}
+	if(val) {
+		if(val->flags & (PV_TYPE_INT | PV_VAL_INT)) {
+			if(pv_get_sintval(msg, param, val, val->ri) < 0)
+				goto err;
+		}
 
-	if(pv_printf_s(msg, pv_format, &fval) < 0) {
-		LM_ERR("cannot parse format: %.*s\n", val->rs.len, val->rs.s);
-		goto err;
+		if(pv_parse_format(&val->rs, &pv_format) < 0) {
+			LM_ERR("cannot parse format: %.*s\n", val->rs.len, val->rs.s);
+			goto err;
+		}
+		if(pv_printf_s(msg, pv_format, &fval) < 0) {
+			LM_ERR("cannot parse format: %.*s\n", val->rs.len, val->rs.s);
+			goto err;
+		}
 	}
 
 	xval = pvh_xavi_get_value(msg, &_pvh_params.xavi_name, &hname, 0);
@@ -947,12 +960,14 @@ int pvh_merge_uri(struct sip_msg *msg, enum action_type type, str *cur,
 	}
 
 	if(type == SET_USERPHONE_T) {
-		if(pvh_str_append(merged, new, max_hdr) < 0) {
-			LM_ERR("new uri[%d] exceeds header_value_size\n", new->len);
-			goto err;
-		}
-		if(pvh_str_append(merged, &space, max_hdr) < 0) {
-			goto err;
+		if(new->len > 0) {
+			if(pvh_str_append(merged, new, max_hdr) < 0) {
+				LM_ERR("new value[%d] exceeds header_value_size\n", new->len);
+				goto err;
+			}
+			if(pvh_str_append(merged, &space, max_hdr) < 0) {
+				goto err;
+			}
 		}
 	} else if(tb.display.len > 0) {
 		if(pvh_str_append(merged, &tb.display, max_hdr) < 0) {
-- 
2.43.0

